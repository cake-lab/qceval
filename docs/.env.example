# QCEval environment configuration
# Copy this file to .env for local development, or set these variables in your shell.

# Base directory for downloaded benchmark data.
# - Default: ~/.qceval
# - Dev override: .qceval (repo-local)
QCEVAL_HOME=.qceval

# Public benchmark source repository used by default.
QCEVAL_BENCHMARK_REPO_URL=https://github.com/cake-lab/qceval.git

# Optional: if you already have a benchmark checkout locally, point here instead of cloning.
# This should be the directory that contains the benchmarks/ folder.
# QCEVAL_BENCHMARKS_SOURCE_DIR=/absolute/path/to/qceval
